# Correlación de x con y con álgebra lineal. Crear una matriz de convolución con x y multiplicar por y

sr = 10000
t = np.arange(1000)/sr
x = np.random.randn(len(t))
y = np.random.randn(len(t))

X = np.zeros((len(x)+len(y)-1,len(y)))

for i in range(len(y)):
    X[i:i+len(x),i] = x

