# stft en python

hop_size = 512
win_size = 2048


S = np.zeros((win_size//2+1, len(x)//hop_size), dtype=complex)

for frame_i, time_i in enumerate(range(0, len(x), hop_size)):
    frame = x[time_i:time_i+win_size]
    if len(frame) < win_size:
        frame = np.pad(frame, (0, win_size - len(frame)), 'constant')
    window = np.hanning(len(frame))
    frame = frame * window
    spectrum = np.fft.rfft(frame)
    S[:, time_i] = spectrum

plt.figure(figsize=(10, 4))
plt.imshow(10*np.log10(np.abs(S)), aspect='auto', origin='lower', cmap='gray')
plt.colorbar()
plt.xlabel('Frames')
plt.ylabel('Frecuencia (bins)')
